# Template for compose.yaml. Copy to `.env` (git-ignored) and replace EVERY <change-me-...> value.
# Never commit real values. Use URL-safe random strings of at least 16 characters, e.g.
#   python3 -c "import secrets; print(secrets.token_hex(24))"
# The role bootstrap (deploy/postgres/init/10-ao-roles.sh) refuses placeholder values.

AO_ENV=dev
AO_PG_SUPERUSER_PASSWORD=<change-me-superuser-password>
AO_PG_MIGRATION_PASSWORD=<change-me-migration-password>
AO_PG_APP_PASSWORD=<change-me-app-password>
